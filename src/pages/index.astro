---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Inicio - GameLib">
	<main class="container mx-auto mt-8">
		<h1 class="text-4xl font-extrabold text-blue-700 dark:text-blue-400 mb-4 text-center">Bienvenido a GameLib</h1>
        <p class="text-lg text-gray-700 dark:text-gray-300 mb-10 text-center">Tu biblioteca personal de videojuegos. Organiza, descubre y comparte tus juegos favoritos.</p>

        <!-- Hero Section adaptado -->
        <section class="relative bg-gradient-to-r from-blue-700 via-blue-800 to-gray-900 rounded-xl shadow-lg overflow-hidden mb-12">
            <img src="https://images.unsplash.com/photo-1511512578047-dfb367046420?auto=format&fit=crop&w=1200&q=80" alt="Videojuegos" class="absolute inset-0 w-full h-full object-cover opacity-30 pointer-events-none" />
            <div class="relative z-10 px-6 py-20 md:py-32 text-center">
                <h2 class="text-3xl md:text-5xl font-bold text-white mb-4 drop-shadow-lg">Gestiona tu colección de videojuegos</h2>
                <p class="text-lg md:text-2xl text-blue-100 mb-8">Lleva el control de tus juegos, plataformas y progreso. ¡Nunca olvides qué jugar después!</p>
                <div class="flex flex-col sm:flex-row justify-center gap-4">
                    <a href="/library" class="inline-flex items-center justify-center px-6 py-3 text-lg font-semibold rounded-lg bg-blue-600 hover:bg-blue-800 text-white shadow transition">
                        Ver mi biblioteca
                        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                        </svg>
                    </a>
                    <a href="/agregar" class="inline-flex items-center justify-center px-6 py-3 text-lg font-semibold rounded-lg bg-white/80 hover:bg-white text-blue-700 shadow transition border border-blue-200">
                        Agregar juego
                    </a>
                </div>
            </div>
        </section>

		<!-- Features Section -->
        <section class="mb-16">
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-8 text-center">¿Qué puedes hacer con GameLib?</h3>
            <div class="grid md:grid-cols-3 gap-8">
                <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6 flex flex-col items-center">
                    <svg class="w-10 h-10 text-blue-600 mb-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V7M16 3v4M8 3v4m-5 4h18"/>
                    </svg>
                    <h4 class="font-semibold text-lg mb-2">Organiza tu colección</h4>
                    <p class="text-gray-600 dark:text-gray-300 text-center">Añade, edita y elimina juegos. Clasifícalos por plataforma, género y estado.</p>
                </div>
                <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6 flex flex-col items-center">
                    <svg class="w-10 h-10 text-green-500 mb-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <h4 class="font-semibold text-lg mb-2">Lleva el progreso</h4>
                    <p class="text-gray-600 dark:text-gray-300 text-center">Marca juegos como completados, en progreso o pendientes. ¡No pierdas el hilo!</p>
                </div>
                <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6 flex flex-col items-center">
                    <svg class="w-10 h-10 text-purple-500 mb-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m9-4V6a4 4 0 00-8 0v4m12 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <h4 class="font-semibold text-lg mb-2">Comparte y descubre</h4>
                    <p class="text-gray-600 dark:text-gray-300 text-center">Comparte tu biblioteca y descubre recomendaciones de otros jugadores.</p>
                </div>
            </div>
        </section>

		<!-- Call to Action -->
        <section class="bg-blue-50 dark:bg-blue-900 rounded-lg p-8 flex flex-col items-center shadow">
            <h4 class="text-xl font-bold text-blue-800 dark:text-blue-200 mb-2">¿Listo para empezar?</h4>
            <p class="text-gray-700 dark:text-gray-300 mb-4 text-center">Crea tu cuenta y comienza a construir tu biblioteca de videojuegos personalizada.</p>
            <a href="/registro" class="inline-block px-8 py-3 bg-blue-700 text-white font-semibold rounded-lg shadow hover:bg-blue-800 transition">Crear cuenta</a>
        </section>

	</main>
</Layout>